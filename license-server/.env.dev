# Settings for running the licence server on the developer's own machine
# (npm run dev). Not for a real installation - see README.md for that.

# The same database the console utility writes with --dev, so a key issued by
# `node tools/kdr-license license --dev ...` is one this server knows.
KDR_LICENSE_DB=../tools/kdr-license/dev/license.db

# Sign with the development key, which only debug builds of KADRA accept.
KDR_DEV_SIGNING=1

# The session cookie may travel over plain HTTP: there is no TLS on localhost.
INSECURE_COOKIE=1
